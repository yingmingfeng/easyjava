db.driver-class-name=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/your_database?useSSL=false&serverTimezone=GMT%2B8
db.username=your_username
db.password=your_password
#是否忽略表前缀 tb_product_info => product_info
ignore.table.prefix=true
#需要忽略的属性(配合lombok注解使用,使用@JsonIgnore注解会有冲突)
ignore.bean.tojson.field=companyId,status
ignore.bean.tojson.expression=@JsonIgnoreProperties({%s})
ignore.bean.tojson.class=import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
#日期格式序列化
bean.date.format.expression=@JsonFormat(pattern = "%s",timezone = "GMT+8")
bean.date.format.class=import com.fasterxml.jackson.annotation.JsonFormat;
#日期格式反序列化
bean.date.unformat.expression=@DateTimeFormat(pattern = "%s")
bean.date.unformat.class=import org.springframework.format.annotation.DateTimeFormat;
#使用lombok注解生成setter和getter
bean.setter.expression=@Setter
bean.setter.class=import lombok.Setter;
bean.getter.expression=@Getter
bean.getter.class=import lombok.Getter;
#参数bean后缀
suffix.bean.query=Query
#参数模糊搜索后缀
suffix.bean.query.fuzzy=Fuzzy
#参数日期起止
suffix.bean.query.time.start=Start
suffix.bean.query.time.end=End
#mapper的后缀
suffix.mappers=Mapper
#文件输出路径(生成代码的输出根目录,需以 /src/main/ 结尾)
path.base = /path/to/easyjava-demo/src/main/
#包名
package.base = com.easyjava
package.po = entity.po
package.vo = entity.vo
package.query = entity.query
package.utils = utils
package.enums = enums
package.exception = exception

package.mappers = mappers
package.service = service
package.service.impl = service.Impl
package.controller = controller
##作者名称
comment.author=YourName
